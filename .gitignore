# ============================================================
# 麦麦自主规划插件 v4 - .gitignore（v4.5.0 重构精简版）
# ============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.python-version

# ── 运行时数据与日志（不进仓库）──────────────────────────────
data/
*.log
config.toml
next_day_prompt.json

# ── 本机专属 / 开发残留 ─────────────────────────────────────
config_back/
changelogs/
POC_RESULT.md
.claude/
.bot/
.dsh/

# ── 环境与编辑器 ────────────────────────────────────────────
.env
.env.*
!.env.example
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
