{
  "manifest_version": 2,
  "version": "4.6.1",
  "name": "麦麦自主规划插件 v4",
  "description": "让麦麦具备自主规划能力，通过 LLM 智能生成符合人设的日常生活日程。v4.6.1: 修复 MaiBot 1.2.x 上 planner 注入静默失效（兼容 items/ContextItem 快照 payload）+ Hook 返回全量回传 kwargs + replyer 注入改为协作式追加（不覆盖其他插件的 extra_prompt）。",
  "author": {
    "name": "靓仔",
    "url": "https://github.com/xuqian13"
  },
  "license": "AGPL-3.0",
  "urls": {
    "repository": "https://github.com/xuqian13/autonomous_planning_plugin"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "display": {
    "icon": {
      "type": "local",
      "value": "logo.jpg",
      "fallback": "logo",
      "background": "#F0F5FC"
    }
  },
  "capabilities": [
    "send.text",
    "send.image",
    "send.forward",
    "config.get",
    "config.get_plugin",
    "llm.generate",
    "message.get_by_time_in_chat",
    "chat.get_all_streams",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "knowledge.search",
    "maisaka.proactive.trigger",
    "frequency.set_adjust"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "xuqian13.autonomous-planning-plugin-v4"
}
