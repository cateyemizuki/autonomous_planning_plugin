{
  "manifest_version": 2,
  "version": "4.3.2",
  "name": "麦麦自主规划插件 v4",
  "description": "让麦麦具备自主规划能力，通过 LLM 智能生成符合人设的日常生活日程。v4.3.2 hotfix: 修复主程序时间戳消息污染意图分类导致所有问题被误判为 query_current 的 bug。",
  "author": {
    "name": "靓仔",
    "url": "https://github.com/xuqian13"
  },
  "license": "AGPL-3.0",
  "urls": {
    "repository": "https://github.com/xuqian13/autonomous_planning_plugin"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.0.0"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.image",
    "config.get",
    "config.get_plugin",
    "llm.generate",
    "message.get_recent",
    "message.get_by_time_in_chat",
    "chat.get_all_streams",
    "knowledge.search"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  },
  "id": "xuqian13.autonomous-planning-plugin-v4"
}
