{
  "manifest_version": 2,
  "version": "4.4.3",
  "name": "麦麦自主规划插件 v4",
  "description": "让麦麦具备自主规划能力，通过 LLM 智能生成符合人设的日常生活日程。v4.4.3 hotfix: 剥除主程序 build_planner_prefix 的 <message msg_id=...> 包装，让意图分类拿到真实用户文本。",
  "author": {
    "name": "靓仔",
    "url": "https://github.com/xuqian13"
  },
  "license": "AGPL-3.0",
  "urls": {
    "repository": "https://github.com/xuqian13/autonomous_planning_plugin"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.0.0"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.image",
    "config.get",
    "config.get_plugin",
    "llm.generate",
    "message.get_recent",
    "message.get_by_time_in_chat",
    "chat.get_all_streams",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "knowledge.search",
    "maisaka.proactive.trigger",
    "frequency.set_adjust"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  },
  "id": "xuqian13.autonomous-planning-plugin-v4"
}
