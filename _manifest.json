{
  "manifest_version": 2,
  "version": "4.0.0",
  "name": "麦麦自主规划插件 v4",
  "description": "让麦麦具备自主规划能力，通过 LLM 智能生成符合人设的日常生活日程。v4 全面基于 maibot_sdk 2.x 重写，支持新版 Host ↔ Runner 子进程架构，注入入口迁移到 HookHandler(maisaka.planner.before_request)。",
  "author": {
    "name": "靓仔",
    "url": "https://github.com/xuqian13"
  },
  "license": "AGPL-3.0",
  "urls": {
    "repository": "https://github.com/xuqian13/autonomous_planning_plugin"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.0.0"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.image",
    "config.get",
    "config.get_plugin",
    "llm.generate",
    "message.get_recent"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  },
  "id": "xuqian13.autonomous-planning-plugin-v4"
}
